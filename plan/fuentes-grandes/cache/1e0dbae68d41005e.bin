        <div id="m12349-12347-12350"><div class="module-free-html-ads " id="m12354-12353-12355">
    
<div><div data-revenuemaker-ads id="sticky"></div></div></div></div>
    </aside>

    <aside class="c-add c-add-bottom slider">
        
    </aside>

<script type="text/javascript">
    var logToConsole = logToConsole || console.log;
    var width = screen.width;

    function isMobileDevice(){
        if(typeof window.ontouchstart !== 'undefined' && width < 1024){
            return 'mobile';
        }else{
            return 'desktop';
        }
    }

    var platform = isMobileDevice();
    var loc = window.location.href.split('?')[0].replace(location.origin,'');

    // ── Publicidad entre párrafos en móvil — CREACIÓN de nuevos slots ────────
    // En móvil, cuando se está en una página de artículo (.html), se inyectan
    // divs publicitarios entre párrafos. Los IDs se asignan SIN número en la
    // creación (id="roba", id="banner"…) y el número definitivo lo pone
    // assignAdNumbers() una vez insertados todos los elementos.
    // ────────────────────────────────────────────────────────────────────────

    function hasClassElements(className) {
        return 0 < document.getElementsByClassName(className).length;
    }

    /**
     * Config para inyección de anuncios entre párrafos.
     * mbOnly: true  → solo en móvil.
     * timesAx: 4    → cada 4 párrafos (y también tras el 1º).
     */
    function getAdxConfig() {
        var config = {
            contentType: 'generic',
            itemToCheck: 'paragraph',
            mbOnly: true,
            timesAx: 4,
            adType: 'roba',
            nAxClass: 'c-add-300'
        };

        if (true === hasClassElements('c-detail__gallery__item')) {
            config.contentType = 'gallery';
            config.itemToCheck = 'c-detail__gallery__item';
            config.mbOnly = false;
            config.timesAx = 3;
            if ('mobile' !== platform) { config.adType = 'banner'; }
            config.nAxClass = 'c-add-990-gallery';
        }

        if (true === hasClassElements('c-detail__post')) {
            config.contentType = 'mam';
            config.itemToCheck = 'c-detail__post';
        }

        return config;
    }

    /**
     * Crea e inserta un div publicitario después del nodo de referencia.
     * El id se establece con el tipo SIN número (p.ej. id="roba").
     * assignAdNumbers() se encarga de añadir el número secuencial después.
     *
     * @param {object} options  { type, classes, node_reference }
     * @returns {boolean}
     */
    function generateAd(options) {
        if ('object' !== typeof options || Array.isArray(options)) { return false; }

        var type          = options.type;
        var classes       = Array.isArray(options.classes) ? options.classes : [];
        var nodeReference = options.node_reference;

        if (!type || !nodeReference) { return false; }

        var domElement = document.createElement('div');
        domElement.setAttribute('id', type);          // sin número; assignAdNumbers() lo añade
        // mark as a revenuemaker slot so numbering utility can find it globally
        domElement.setAttribute('data-revenuemaker-ads', 'true');
        // Use minimal class expected by revenuemaker consumers
        domElement.className = 'lib_dx c-add-300';

        if (nodeReference.nextSibling) {
            nodeReference.parentNode.insertBefore(domElement, nodeReference.nextSibling);
        } else {
            nodeReference.parentNode.appendChild(domElement);
        }

        logToConsole('generateAd: inserted #' + type + ' after paragraph');
        return true;
    }

    /**
     * Inyecta divs publicitarios entre párrafos del artículo (solo móvil por defecto).
     * Omite páginas cuyo DOM contenga alguna de las clases excluidas.
     *
     * @param {object} options  { excluded_content_classes: [] }
     * @returns {Array}
     */
    function createContentAds(options) {
        options = options || {};
        var createdAds = [];
        var excludedContentClasses = options.excluded_content_classes || [];

        if (!Array.isArray(excludedContentClasses)) {
            excludedContentClasses = typeof excludedContentClasses === 'string'
                ? [excludedContentClasses] : [];
        }

        if (excludedContentClasses.some(function(cls) { return hasClassElements(cls); })) {
            logToConsole('createContentAds: skipped (excluded class present)');
            return createdAds;
        }

        var adxConfig = getAdxConfig();

        if (adxConfig.mbOnly && 'mobile' !== platform) {
            logToConsole('createContentAds: skipped (not mobile)');
            return createdAds;
        }

        var p = document.getElementsByClassName(adxConfig.itemToCheck);

        for (var i = 0; i < p.length; i++) {
            // Skip insertion if this is the last element — don't put ads after the final paragraph/item
            if (i === p.length - 1) { continue; }

            var shouldInsert = (i === 0 && adxConfig.timesAx === 4) ||
                               (i > 0 && Number.isInteger(i / adxConfig.timesAx) && i / adxConfig.timesAx !== 0);

            if (!shouldInsert) { continue; }

            var adClasses = [adxConfig.nAxClass, 'lib_dx', 'c-add'];
            if (adxConfig.mbOnly) { adClasses.push('xs'); }

            var inserted = generateAd({
                type: adxConfig.adType,
                classes: adClasses,
                node_reference: p[i]
            });

            if (inserted) {
                createdAds.push({ type: adxConfig.adType });
            }
        }

        return createdAds;
    }

    // Activar en páginas de artículo: crear slots y numerar.
    if (loc.indexOf('.html') > -1) {
        var createdAds = createContentAds({ excluded_content_classes: ['c-detail-opinion'] });
        if (createdAds.length > 0) {
            logToConsole('createContentAds: inserted ' + createdAds.length + ' ad slots');
            // numbering now delegated to external configuration script
            // previously: var adCounters = assignAdNumbers();
            // previously: logToConsole('assignAdNumbers: result ' + JSON.stringify(adCounters));
        }
    }

    // ── CÓDIGO ANTERIOR (reubicación de slots existentes) — COMENTADO ────────
    // Se conserva por si se prefiere volver al enfoque de mover los elementos
    // publicitarios ya presentes en el DOM en lugar de crear nuevos.
    //
    // function collectExistingAdElements() {
    //     var selectors = ['[data-revenuemaker-ads]', 'aside[wf-role^="ads_article_sidebar"]'];
    //     var found = [];
    //     var articleBody = document.querySelector('.c-detail__body');
    //     selectors.forEach(function(sel) {
    //         var els = document.querySelectorAll(sel);
    //         for (var i = 0; i < els.length; i++) {
    //             var el = els[i];
    //             if (articleBody && articleBody.contains(el)) { continue; }
    //             if (found.indexOf(el) === -1) { found.push(el); }
    //         }
    //     });
    //     return found;
    // }
    //
    // function relocateContentAds(options) {
    //     // Solo móvil; excluye 'c-detail-opinion'
    //     // timesAx = 4: mueve el 1er ad tras párrafo[0], luego cada 4
    //     // No crea divs nuevos, mueve los existentes en el DOM
    // }
    //
    // if (loc.indexOf('.html') > -1) {
    //     relocateContentAds({ excluded_content_classes: ['c-detail-opinion'] });
    // }
    // ────────────────────────────────────────────────────────────────────────


    function logToConsole(msg, level) {
        level = level || 'info';
        if (!Boolean(msg)) return false;
        var params = new URLSearchParams(window.location.search);
        var debug = parseInt(params.get('debug'));
        if (isNaN(debug) || 0 !== debug) { debug = 1; }
        if (0 === debug && 'info' === level) return false;
        var date = new Date();
        date = date.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' });
        var consoleCommand = level === 'warning' ? 'warn' : (level === 'info' ? 'log' : level);
        if (-1 === ['info','warn','warning','error'].indexOf(level)) { level = 'info'; }
        var dateAndLevel = '[' + date + '] ' + level.toUpperCase() + ':';
        if ('string' === typeof msg) {
            console[consoleCommand](dateAndLevel + ' ' + msg);
            return true;
        }
        if (!Array.isArray(msg)) { msg = [msg]; }
        msg.unshift(dateAndLevel);
        console[consoleCommand].apply(console, msg);
        return true;
    }

    const verifyOutbrain = () => {
        if(platform == 'desktop' &&
            document.querySelectorAll('.c-detail__body > .paragraph').length != 3 &&
            dataLayer[0].db_tpc != "directo" &&
            dataLayer[0].db_tpc != "podcast" &&
            dataLayer[0].db_tpc != "galeria" &&
            dataLayer[0].db_tpc != "opinion" &&
            opta == "no"
        ){
            if(document.getElementsByClassName("OUTBRAIN").length != 0){
                document.getElementsByClassName("OUTBRAIN")[0].setAttribute("data-widget-id", "AR_1")
            }
        }
        return true;
    }

    const loadOutbrain = async () => {
        await verifyOutbrain()
        let script = document.createElement('script');
        script.src = outbrainUrl;
        script.setAttribute("async", "true");
        document.head.appendChild(script);
    }

    if(typeof outbrainUrl !== 'undefined')
        loadOutbrain();

    // ── Posicionamiento del banner1 respecto al header ──────────────────────
    // Desktop: banner1 encima del header
    // Móvil: banner1 debajo del header (todo el portal salvo la portada)
    // ────────────────────────────────────────────────────────────────────────
    (function positionBanner1() {
        var banner1 = document.getElementById('banner1');
        if (!banner1) { return; }

        var header = document.querySelector('.c-header');
        if (!header) { return; }

        if (platform === 'desktop') {
            // Desktop: banner1 encima del header
            if (header.parentNode.firstChild !== banner1) {
                header.parentNode.insertBefore(banner1, header);
            }
        } else {
            // Móvil: banner1 debajo del header (salvo en portada)
            if (loc === '/') { return; }
            if (header.parentNode.lastChild !== banner1) {
                header.parentNode.appendChild(banner1);
            }
        }
    })();

    
    if(document.querySelectorAll('.marcador-portada .content-free-html opta-widget').length > 0){
        let template = document.getElementsByTagName("template")[0];
        let node = template.content.cloneNode(true);
        document.body.appendChild(node);
    }
</script>
                
