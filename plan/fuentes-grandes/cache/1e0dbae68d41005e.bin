<script>
document.addEventListener('DOMContentLoaded', function () {
    window.assignAdNumbersFromConfig(['roba', 'banner', 'boton'], {
        rootSelector: '.c-detail__body',
        idAttr: 'attr_type',
        bumpExisting: false
    });
    if (window.location.pathname.indexOf('/area-privada/') !== -1) {
        return;
    }
    var adsScript = document.createElement('script');
    adsScript.src = 'https://cdn.revenuemakerdata.com/prebid/debate/pro/rmads.js';
    adsScript.async = true;
    document.head.appendChild(adsScript);
    if ('requestIdleCallback' in window) {
        requestIdleCallback(initMobileSticky, { timeout: 2000 });
    } else {
        setTimeout(initMobileSticky, 200);
    }
    function initMobileSticky() {
        var isMobile = window.matchMedia('(pointer: coarse) and (max-width: 1023px)').matches;
        if (!isMobile || !('IntersectionObserver' in window)) return;

        var stickyContainer = document.querySelector('aside.c-add.c-add-bottom');
        if (!stickyContainer) return;

        var path = window.location.pathname;
        var isHomepage = (path === '/' || path === '/index.html' || path === '/index.php');
        var triggerElementId = isHomepage ? 'roba1-id' : 'banner1-id';

        var isClosed = false;
        var isVisible = false;
        var visibilityObserver = null;

        stickyContainer.classList.add('sticky_desktop_1_container');
        stickyContainer.style.display = 'none';
        addCloseButton();

        findTriggerElement(20);

        function findTriggerElement(retriesLeft) {
            if (isClosed) return;

            var triggerElement = document.getElementById(triggerElementId);
            if (triggerElement) {
                observeTriggerElement(triggerElement);
            } else if (retriesLeft > 0) {
                setTimeout(function () {
                    findTriggerElement(retriesLeft - 1);
                }, 500);
            }
        }

        function observeTriggerElement(triggerElement) {
            visibilityObserver = new IntersectionObserver(function (entries) {
                var entry = entries[entries.length - 1];
                var rect = entry.boundingClientRect;

                var isHidden = rect.width === 0 && rect.height === 0;

                var hasExitedTop = !entry.isIntersecting && rect.bottom <= 0;

                setStickyVisible(!isHidden && hasExitedTop);
            }, { threshold: 0 });

            visibilityObserver.observe(triggerElement);
        }

        function setStickyVisible(shouldShow) {
            if (isClosed || shouldShow === isVisible) return;

            isVisible = shouldShow;
            stickyContainer.style.display = shouldShow ? 'flex' : 'none';
        }

        function addCloseButton() {
            if (document.getElementById('sticky_desktop_1_close_button')) return;

            var buttonWrapper = document.createElement('div');
            buttonWrapper.className = 'close-button-container';

            var closeButton = document.createElement('img');
            closeButton.className = 'close-button-img';
            closeButton.id = 'sticky_desktop_1_close_button';
            closeButton.src = 'https://ced-ns.sascdn.com/diff/templates/images/close-retina.png';
            closeButton.alt = 'Cerrar publicidad';
            closeButton.setAttribute('role', 'button');
            closeButton.addEventListener('click', closeSticky, { once: true });

            buttonWrapper.appendChild(closeButton);
            stickyContainer.appendChild(buttonWrapper);
        }

        function closeSticky() {
            isClosed = true;
            isVisible = false;
            stickyContainer.style.display = 'none';

            if (visibilityObserver) {
                visibilityObserver.disconnect();
                visibilityObserver = null;
            }
        }
    }
});
</script>
