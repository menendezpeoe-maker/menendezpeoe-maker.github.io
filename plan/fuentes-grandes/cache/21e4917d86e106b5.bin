                        <!--[if IE 9]></video><![endif]-->
            <img
                class="lazy"
                loading="lazy"
                data-src="https://static.eldiario.es/clip/0a05a12b-947f-4e23-8af2-6f3ab381c6f1_16-9-aspect-ratio_default_0.jpg"
                src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 880 495'%3E%3C/svg%3E"
