<aside class="know-more know-more--with-image">
    <a
        href="https://www.eldiario.es/madrid/somos/gobierno-almeida-inflo-cifra-multas-pisos-turisticos-ilegales-69-sanciones-12-000-licencia_1_11776590.html"
        data-mrf-recirculation="saber-mas"
        data-dl-event="saber-mas"
    >
        <p class="know-more__title">El Gobierno de Almeida impone 183 multas para intentar frenar los 12.000 pisos turísticos ilegales de Madrid</p>

                    






    <picture
                class="know-more__img"
                
    >
                    <!--[if IE 9]><video style="display: none;"><![endif]-->
            
                                                <source
                        media="(max-width: 767px)"
                        type="image/webp"
                        srcset="https://static.eldiario.es/clip/0a05a12b-947f-4e23-8af2-6f3ab381c6f1_16-9-aspect-ratio_50p_0.webp"
                    >
                                <source
                    media="(max-width: 767px)"
                    type="image/jpg"
                    srcset="https://static.eldiario.es/clip/0a05a12b-947f-4e23-8af2-6f3ab381c6f1_16-9-aspect-ratio_50p_0.jpg"
                >
            
                                                <source
                        media="(min-width: 768px)"
                        type="image/webp"
