    <div class="cmp-cf-author-date_text">
        
            <div class="cmp-cf-author-date_author base-inter-bold">
                <p>Agencias | Redacción</p>
            </div>
        
        <div class="cmp-cf-author-date_date" data-elhuyar-irakurri="true">
            <time class="created" datestime="2017-07-05T00:19:34+02:00"><span>05/07/2017 - 00:19</span></time>
            
                <span class="author-separator"></span>
                <p><span>Última actualización </span></p>
                <time class="created" datestime="2017-07-05T00:19:34+02:00"><span>05/07/2017 - 00:19</span></time>
            
        </div>
