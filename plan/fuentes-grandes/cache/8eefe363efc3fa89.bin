                    srcset="https://static.eldiario.es/clip/e8df2480-adc8-4523-b041-fdcd5fe1746b_16-9-aspect-ratio_50p_0_x1776y728.jpg"
                >
            
                            <source
                    type="image/webp"
                    srcset="https://static.eldiario.es/clip/e8df2480-adc8-4523-b041-fdcd5fe1746b_16-9-aspect-ratio_default_0_x1776y728.webp"
