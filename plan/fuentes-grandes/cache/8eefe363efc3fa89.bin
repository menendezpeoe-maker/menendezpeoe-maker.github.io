                            </div>
                
    
        
        
    
                

<aside class="know-more know-more--with-image">
    <a
        href="https://www.eldiario.es/sociedad/gobierno-pone-requisitos-universidades-privadas-informe-vinculante-minimo-4500-estudiantes_1_12178061.html"
        data-mrf-recirculation="saber-mas-abajo"
        data-dl-event="saber-mas-abajo"
    >
        <p class="know-more__title">El Gobierno pone más requisitos a las universidades privadas: un informe vinculante y un mínimo de 4.500 estudiantes</p>

                    






    <picture
                class="know-more__img"
                
    >
                    <!--[if IE 9]><video style="display: none;"><![endif]-->
            
                                                <source
                        media="(max-width: 767px)"
                        type="image/webp"
                        srcset="https://static.eldiario.es/clip/e8df2480-adc8-4523-b041-fdcd5fe1746b_16-9-aspect-ratio_50p_0_x1776y728.webp"
                    >
                                <source
                    media="(max-width: 767px)"
                    type="image/jpg"
                    srcset="https://static.eldiario.es/clip/e8df2480-adc8-4523-b041-fdcd5fe1746b_16-9-aspect-ratio_50p_0_x1776y728.jpg"
                >
            
                                                <source
                        media="(min-width: 768px)"
                        type="image/webp"
                        srcset="https://static.eldiario.es/clip/e8df2480-adc8-4523-b041-fdcd5fe1746b_16-9-aspect-ratio_50p_0_x1776y728.webp"
                    >
                                <source
                    media="(min-width: 768px)"
