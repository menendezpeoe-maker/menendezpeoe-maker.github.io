                    srcset="https://static.eldiario.es/clip/437e3b9e-ffac-41c6-8705-7fa11f8b9cfb_16-9-aspect-ratio_50p_0.jpg"
                >
            
                                                <source
                        media="(min-width: 768px)"
                        type="image/webp"
                        srcset="https://static.eldiario.es/clip/437e3b9e-ffac-41c6-8705-7fa11f8b9cfb_16-9-aspect-ratio_50p_0.webp"
                    >
                                <source
                    media="(min-width: 768px)"
                    type="image/jpg"
                    srcset="https://static.eldiario.es/clip/437e3b9e-ffac-41c6-8705-7fa11f8b9cfb_16-9-aspect-ratio_50p_0.jpg"
                >
            
                            <source
                    type="image/webp"
                    srcset="https://static.eldiario.es/clip/437e3b9e-ffac-41c6-8705-7fa11f8b9cfb_16-9-aspect-ratio_default_0.webp"
                >
                        <!--[if IE 9]></video><![endif]-->
            <img
                class="lazy"
                loading="lazy"
                data-src="https://static.eldiario.es/clip/437e3b9e-ffac-41c6-8705-7fa11f8b9cfb_16-9-aspect-ratio_default_0.jpg"
