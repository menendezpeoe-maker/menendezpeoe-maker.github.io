      // USER data
      function getBBnxCookie(name) {
        const cookies = document.cookie.split('; ');

        for (const cookie of cookies) {
          const [key, value] = cookie.split('=');
          if (key === name) {
            return decodeURIComponent(value);
          }
        }

        return null;
      }

      let userCookie = getBBnxCookie('Brainhub:User');
      if (userCookie !== null) {
        try {
          userCookie = JSON.parse(decodeURIComponent(userCookie));
        } catch (e) {
          userCookie = null;
        }
      } else {
        userCookie = null;
      }

      function getBBnxCookieUserVar(variable) {
        return userCookie?.[variable];
      }

      function getBBnxprofile(userType, status) {
        if (status === 'ex socio') {
          return 'ex Socio';
        }
        switch (userType) {
          case 0:
            return 'Anónimo';
          case 1:
            return 'Registrado';
          case 2:
            return 'Socio bonificado 0 euros';
          case 50:
            return 'Socio bonificado 0 euros revisable';
          case 3:
            return 'Socios bonificado 1-6 euros';
          case 4:
            return 'Socio estándar';
          case 5:
            return 'Socio mecenas';
          case 51:
            return 'Socio regalo con publicidad';
          default:
            return '';
        }
      }

      const getBBnxMapRegionFromCookie = (regionName) => {
        const normalized = regionName?.trim();

        switch (normalized) {
          case 'Madrid':
          case 'Community of Madrid':
            return 'Madrid';

          case 'Catalonia':
            return 'Cataluña';

          case 'Andalusia':
          case 'Ceuta':
          case 'Melilla':
            return 'Andalucia';

          case 'Valencian Community':
            return 'Valencia';

          case 'Basque Country':
            return 'Pais Vasco';

          case 'Canary Islands':
            return 'Canarias';

          case 'Castile and Leon':
            return 'Castilla y Leon';

          case 'Balearic Islands':
            return 'Islas Baleares';

          case 'Murcia':
          case 'Region of Murcia':
            return 'Murcia';

          case 'Castile-La Mancha':
            return 'Castilla-La Mancha';

          case 'Aragon':
          case 'Asturias':
          case 'Navarre':
          case 'La Rioja':
          case 'Cantabria':
          case 'Extremadura':
          case 'Galicia':
            return normalized;

          default:
            return null;
        }
      };

      const bbnxUserID = getBBnxCookieUserVar('id');
      const bbnxStatus = getBBnxCookieUserVar('status');
      const bbnxEmail = getBBnxCookieUserVar('email');

      function getBBnxUserState() {
        return !!bbnxUserID ? 'logado' : 'no logado';
      }

      function getBBnxSubscriptionType(subscriptionType) {
        if (!subscriptionType && subscriptionType !== 0) {
          return '';
        }

        switch (subscriptionType) {
          case 1:
            return 'Standard';
          case 2:
            return 'Mongolia';
          case 3:
            return 'Norte';
          case 4:
            return 'BallenaBlanca';
          case 5:
            return 'BonusFree';
          case 6:
            return 'BonusWithPay';
          case 7:
            return 'Google';
          case 8:
            return 'Filmin';
          case 9:
            return 'TeatroReal';
          case 10:
            return 'Apple';
          case 11:
            return 'Podimo';
          default:
            return subscriptionType;
        }
      }

      const getBBnxCurrentDate = new Date();
      const dataLayerUser = {
        userID: bbnxUserID || '',
        userPerfil: getBBnxprofile(getBBnxCookieUserVar('type') ?? 0, bbnxStatus) || '',
        userSexo: getBBnxCookieUserVar('sex') || '',
        userProvincia: getBBnxCookieUserVar('province') || '',
        userRegion: getBBnxMapRegionFromCookie(getBBnxCookie('ed_device-region-max_60d')) || '',
        userAnoNacimiento: getBBnxCookieUserVar('birthYear') || '',
        userAltaUsuario: getBBnxCookieUserVar('registerDate') || '',
        userLogin: getBBnxCookieUserVar('loginDate') || '',
        userLastAccess: getBBnxCurrentDate.getUTCFullYear() + "-" + parseInt(parseInt(getBBnxCurrentDate.getUTCMonth()) + 1) + "-" + getBBnxCurrentDate.getUTCDate(),
        userAgent: window.navigator.userAgent || '',
        userState: getBBnxUserState() || '',
        userStatus: bbnxStatus || '',
        userAutentification: 'eldiario',
        userFormaPago: getBBnxCookieUserVar('paymentMethod') || '',
        userNumeroRenovaciones: getBBnxCookieUserVar('renovationCount') || '',
        userModalidadSubscripcion: getBBnxCookieUserVar('subscriptionMode') || '',
        userCampaign: getBBnxCookieUserVar('campaign') || '',
        userSource: getBBnxCookieUserVar('source') || '',
        userMedium: getBBnxCookieUserVar('medium') || '',
        userCarrito: getBBnxCookieUserVar('carrito') || '',
        userTarjetaCaducada: getBBnxCookieUserVar('tarjetaCaducada') || '',
        userPeriodoGracia: getBBnxCookieUserVar('periodoGracia') || '',
        subscriptionType: getBBnxSubscriptionType(getBBnxCookieUserVar('subscriptionType')) || '',
        // Viewport
        isMovil: (Math.max(document.documentElement.clientWidth, window.innerWidth || 0) < 768),
      };

                        
      const rfv = sessionStorage.getItem('compass_rfv_197') || null;
      if (rfv) {
        dataLayerUser.userRfv = JSON.parse(rfv).rfv.rfv;
      }
      
      // Integración con MailChimp
      if (bbnxUserID && bbnxEmail) {
        dataLayerUser.isMC = bbnxEmail;
      }

      // Enviamos el los datos dependientes del usuario
      window.dataLayer.push(dataLayerUser);
      document.dispatchEvent(new Event('dataLayerUserLoaded'));
    </script>

    

        
