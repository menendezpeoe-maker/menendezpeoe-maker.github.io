atic.moncloa.com/wp-content/uploads/2020/11/20201119180307.jpg"},"inLanguage":"es"},{"@type":"Person","@id":"https://www.moncloa.com/author/europa-press/","name":"Agencias","url":"https://www.moncloa.com/author/europa-press/","image":{"@type":"ImageObject","@id":"https://static.moncloa.com/wp-content/uploads/2020/06/Moncloa-150x150.jpg","url":"https://static.moncloa.com/wp-content/uploads/2020/06/Moncloa-150x150.jpg","caption":"Agencias","inLanguage":"es"},"worksFor":{"@id":"https://www.moncloa.com/#organization"}},{"@type":"NewsArticle","headline":"PSOE y PP se unen contra Vox en la educaci\u00f3n sin lengua cooficial","keywords":"vox","datePublished":"2020-11-19T18:20:29+01:00","dateModified":"2020-11-19T20:09:58+01:00","author":{"@id":"https://www.moncloa.com/author/europa-press/","name":"Agencias"},"publisher":{"@id":"https://www.moncloa.com/#organization"},"description":"El Congreso de los Diputados ha rechazado este jueves una proposici\u00f3n no de ley de Vox que instaba al Gobierno a garantizar el derecho de los espa\u00f1oles a estudiar &quot;exclusivamente&quot; en castellano, una iniciativa que s\u00f3lo ha sumado a Ciudadanos y que ha contado con el voto en contra del PSOE, el PP, Podemos y los partidos nacionalistas e independentistas.","copyrightYear":"2020","copyrightHolder":{"@id":"https://www.moncloa.com/#organization"},"name":"PSOE y PP se unen contra Vox en la educaci\u00f3n sin lengua cooficial","@id":"https://www.moncloa.com/2020/11/19/psoe-pp-unen-contra-vox-474432/#richSnippet","isPartOf":{"@id":"https://www.moncloa.com/2020/11/19/psoe-pp-unen-contra-vox-474432/#webpage"},"image":{"@id":"https://static.moncloa.com/wp-content/uploads/2020/11/20201119180307.jpg"},"inLanguage":"es","mainEntityOfPage":{"@id":"https://www.moncloa.com/2020/11/19/psoe-pp-unen-contra-vox-474432/#webpage"}}]}</script> <link rel='dns-prefetch' href='//static.moncloa.com' /><link rel='dns-prefetch' href='//cdn.gravitec.net' /><link href='https://static.moncloa.com' rel='