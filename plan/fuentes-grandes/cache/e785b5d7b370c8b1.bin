                    </div>
                    <!-- Turnstile: aparece tras superar el umbral de intentos fallidos -->
                    <div id="fa-turnstile-login" class="fa-turnstile-wrap" style="display:none"></div>
                    <button type="submit" class="fa-modal__submit">Iniciar sesión</button>
                </form>

                <!-- Formulario Registro -->
                <form id="fa-register-form" hidden>
                    <div class="fa-modal__error" hidden></div>
                    <div class="fa-modal__field">
                        <label for="fa-reg-email">Email</label>
                        <input type="email" id="fa-reg-email" name="email"
                               autocomplete="email" placeholder="">
                    </div>
                    <div class="fa-modal__field">
                        <label for="fa-reg-password">Contraseña</label>
                        <input type="password" id="fa-reg-password" name="password"
                               autocomplete="new-password" placeholder="">
                        <span class="fa-modal__hint">Mínimo 8 caracteres</span>
                    </div>
                    <div class="fa-modal__field">
                        <label for="fa-reg-password2">Repite la contraseña</label>
                        <input type="password" id="fa-reg-password2" name="password2"
                               autocomplete="new-password" placeholder="">
                    </div>
                    <!-- Turnstile: siempre activo en registro (invisible salvo comportamiento sospechoso) -->
                    <div id="fa-turnstile-register" class="fa-turnstile-wrap"></div>
                    <button type="submit" class="fa-modal__submit">Crear cuenta</button>
                    <p class="fa-modal__legal">
                        Al registrarte aceptas nuestra
                        <a href="https://theobjective.com/politica-de-privacidad/"
                           target="_blank" rel="noopener">política de privacidad</a>.
                    </p>
                </form>
            </div><!-- /.fa-modal__body -->

        </div><!-- /.fa-modal -->
    </div><!-- /.fa-modal-overlay -->

    <!-- Popup confirmación unfollow -->
    <div id="fa-unfollow-overlay" class="fa-modal-overlay" hidden>
        <div class="fa-unfollow-card" role="dialog" aria-modal="true" aria-labelledby="fa-unfollow-title">
            <div class="fa-unfollow-card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true">
                    <circle cx="18" cy="18" r="18" fill="#000"/>
                    <circle cx="18" cy="14" r="5" fill="#FBE301"/>
                    <path d="M6 30c0-6.627 5.373-12 12-12s12 5.373 12 12" fill="#FBE301"/>
                    <circle cx="30" cy="30" r="9" fill="#000" stroke="#FBE301" stroke-width="1.5"/>
                    <line x1="30" y1="25" x2="30" y2="35" stroke="#FBE301" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="25" y1="30" x2="35" y2="30" stroke="#FBE301" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
            </div>
            <p class="fa-unfollow-card__title" id="fa-unfollow-title">¿Quieres dejar de seguir<br>este autor?</p>
            <div class="fa-unfollow-card__actions">
                <button class="fa-unfollow-card__yes">Sí</button>
                <button class="fa-unfollow-card__cancel">Cancelar</button>
            </div>
        </div>
    </div>
