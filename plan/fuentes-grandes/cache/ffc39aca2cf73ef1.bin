<!-- killslick - Kill Slick slider de articulos relacionados para mostrar como listado -->
<script>
	function generarCadenaAlfanumerica() {
		let longitud = 8;
		const caracteres = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
		let resultado = '';

		for (let i = 0; i < longitud; i++) {
			const indiceAleatorio = Math.floor(Math.random() * caracteres.length);
			resultado += caracteres[indiceAleatorio];
		}

		return resultado;
	}



	$(document).ready(function () {
		setTimeout(function () {
			// $('.slider-x3').slick('unslick');
			// $('.MODULO_VERT_3').removeClass('MODULO_VERT_3');
			// $('.slider-x3').addClass('unslick');

			// console.log("killSlick")
		}, 1000);
		$('.slider-x3').slick({
			infinite: true,
			speed: 300,
			arrows: true,
			slidesToShow: 3,
			slidesToScroll: 1,
		});
	});
</script>
<script>
	// Comment system
	document.addEventListener('DOMContentLoaded', function () {
		const toggleButton = document.querySelector('.toggle-comments');
		const commentsContainer = document.querySelector('.comments-container');
		const arrow = document.querySelector('.arrow');

		// 1. Validamos que existan ANTES de añadir el evento de clic
		if (toggleButton && commentsContainer) {
			toggleButton.addEventListener('click', function () {
				commentsContainer.classList.toggle('hidden');
				if (arrow) arrow.classList.toggle('up'); // Protección extra por si acaso
			});
		}

		// Manejar clic en el botón de responder (querySelectorAll no rompe si está vacío, pero es buena práctica)
		document.querySelectorAll('.reply-btn').forEach(function (button) {
			button.addEventListener('click', function () {
				const replyForm = this.parentNode.nextElementSibling;
				if (replyForm) { // Validamos que el formulario de respuesta exista
					replyForm.classList.toggle('hidden');
				}
			});
		});
	});
</script>
<style>
	.slider-x3.unslick {
		visibility: visible !important;
	}
</style>
