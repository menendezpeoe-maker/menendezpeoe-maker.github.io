$(document).ready(function() {
        // Comprobar si la URL tiene un hash (ej: #modal-suscripcion-new)

        if (window.location.hash) {
            var hash = window.location.hash;

            // Verificar que el elemento existe y es un modal
            if ($(hash).hasClass('modal')) {
                // Abrir el modal usando el método de Materialize
                $(hash).modal('open');
            }
        }
    });


const bannerWatcher = new MutationObserver((mutations) => {
    const width = window.innerWidth;
    
    if (width <= 600) {
        $('.bn-desktop').hide();
        $('.bn-movil').show();
    } else {
        $('.bn-desktop').show();
        $('.bn-movil').hide();
    }
});
bannerWatcher.observe(document.body, { childList: true, subtree: true });

